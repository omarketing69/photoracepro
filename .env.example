# === Base de datos (¡OBLIGATORIO en producción!) =========================
# URL completa de Postgres. NUNCA hardcodear en código.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Tamaño máximo del pool de conexiones (default 10)
DB_POOL_MAX=10

# === Seguridad (¡OBLIGATORIO en producción, >= 32 chars!) =================
# Secret para firmar JWT. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# === CORS ===============================================================
# Orígenes permitidos, separados por coma. Ej:
# CORS_ALLOWED_ORIGINS=https://photoracepro.com,https://www.photoracepro.com
CORS_ALLOWED_ORIGINS=

# === Google Cloud Storage / Vision ======================================
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT_ID=
GCS_BUCKET_NAME=

# === AWS Rekognition (reconocimiento facial para eventos nuevos) =========
# Solo se usa para eventos con faceSearchProvider='rekognition'. Los eventos
# existentes siguen con el matching casero (face-matching.ts) sin cambios.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Flask (microservicio Python, opcional) =============================
FLASK_SECRET_KEY=
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=8000

# === App general =========================================================
NODE_ENV=development
PORT=5000